# Copy to api/.env and web/.env.local

# Supabase (https://supabase.com/dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Hugging Face (https://huggingface.co/settings/tokens)
HF_TOKEN=hf_your_token_here
HF_MODEL=meta-llama/Llama-3.2-1B-Instruct
HF_SENTIMENT_MODEL=ProsusAI/finbert

# API
API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Indian market (NSE via Yahoo Finance). Override default 90-stock large+mid+small watchlist:
MARKET=IN
# WATCHLIST_SYMBOLS=RELIANCE,INDIGO,CDSL,KAYNES

# Admin login (run: python scripts/seed_admin_user.py)
ADMIN_EMAIL=admin@market.in
ADMIN_PASSWORD=your-secure-password
