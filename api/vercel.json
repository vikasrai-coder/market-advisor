{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/intraday",
      "schedule": "0 4-10 * * 1-5"
    }
  ]
}
